# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=weplay
POSTGRES_PASSWORD=weplaysecret
POSTGRES_DB=weplay
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://weplay:weplaysecret@localhost:5432/weplay
SYNC_DATABASE_URL=postgresql://weplay:weplaysecret@localhost:5432/weplay

# Security & Auth
SECRET_KEY=weplay_super_secret_jwt_key_change_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# App Config
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
